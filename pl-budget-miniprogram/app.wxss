/* 全局样式与主题变量（暗色主题，与原 Web 版一致） */
page {
  --bg:#0f1117; --bg2:#1a1d27; --bg3:#232733; --bg4:#2c3040;
  --text:#e8eaed; --text2:#9aa0ab;
  --accent:#6c8cff; --accent2:#4a6aef;
  --green:#34d399; --red:#f87171; --orange:#fbbf24; --purple:#a78bfa;
  --border:#2e3348; --input-bg:#1e2235; --radius:10px;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view, text, input, picker, button { box-sizing: border-box; }
.muted { color: var(--text2); }
.primary-text { color: var(--accent); }
.green-text { color: var(--green); }
.red-text { color: var(--red); }
.orange-text { color: var(--orange); }
